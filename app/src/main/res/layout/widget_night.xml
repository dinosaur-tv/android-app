<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:gravity="center"
    android:orientation="vertical" android:padding="8dp">
    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_moon"
        android:importantForAccessibility="no" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="@string/widget_night" android:textColor="#EFE6D7"
        android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/night_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="#A39A8C" android:textSize="11sp" android:maxLines="2" />
</LinearLayout>
